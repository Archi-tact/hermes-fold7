#!/data/data/com.termux/files/usr/bin/sh
# Termux:Boot 자동시작 스크립트 → ~/.termux/boot/10-hermes 에 설치됨
# 폰 부팅 시: 화면꺼짐 방지 잠금 → 로컬 sshd(브리지) → (설정돼 있으면) 메신저 게이트웨이
termux-wake-lock
sshd

MODE_FILE="$HOME/.hermes-bridge/mode"         # apt | proot
MODE="$(cat "$MODE_FILE" 2>/dev/null || echo apt)"
LOG_DIR="$HOME/.hermes-bridge/logs"; mkdir -p "$LOG_DIR"

# 스킬 보기용 사본을 /sdcard/Hermes/skills 로 갱신 (실패해도 무시)
[ -x "$HOME/hermes-fold7/scripts/70-skills-storage.sh" ] && \
  HERMES_CMD="$([ "$MODE" = proot ] && echo hermes-proot || echo hermes)" \
  bash "$HOME/hermes-fold7/scripts/70-skills-storage.sh" export >> "$LOG_DIR/skills-export.log" 2>&1

# Hermes Fold 폰 화면 서버 (설치돼 있으면) — 부팅 후 Chrome/홈 화면 아이콘으로 바로 사용
if [ -d "$HOME/.hermes-fold" ] && [ -x "$HOME/hermes-fold7/scripts/80-hermes-fold.sh" ]; then
  HERMES_MODE="$MODE" bash "$HOME/hermes-fold7/scripts/80-hermes-fold.sh" start >> "$LOG_DIR/fold.log" 2>&1
  termux-notification --id hermes-fold --ongoing --title "Hermes" --content "Hermes Fold 실행 중 · 눌러서 열기" \
    --action "pm path ai.hermesfold7.hands >/dev/null 2>&1 && am start -n ai.hermesfold7.hands/.ChatActivity >/dev/null 2>&1 || termux-open-url http://127.0.0.1:${FOLD_PORT:-9130}" \
    --button1 "끄기" --button1-action "bash $HOME/hermes-fold7/scripts/80-hermes-fold.sh stop; termux-notification-remove hermes-fold"
fi

# 게이트웨이는 사용자가 명시적으로 켰을 때만 (touch ~/.hermes-bridge/gateway.enabled)
[ -f "$HOME/.hermes-bridge/gateway.enabled" ] || exit 0
pgrep -f "gateway run" >/dev/null 2>&1 && exit 0   # 이미 실행 중(헤르메스 음성이 띄움)이면 중복 실행 안 함

if [ "$MODE" = proot ]; then
  nohup hermes-proot gateway run >> "$LOG_DIR/gateway.log" 2>&1 &
else
  nohup hermes gateway run >> "$LOG_DIR/gateway.log" 2>&1 &
fi
termux-notification --id hermes-gw --ongoing --title "Hermes" --content "게이트웨이 실행 중 ($MODE)" \
  --button1 "중지" --button1-action "pkill -f 'gateway run'; termux-notification-remove hermes-gw"
