#!/data/data/com.termux/files/usr/bin/bash
# phone-bridge — Hermes 에이전트용 '폰 기능' 게이트웨이 (Termux 쪽에서 실행)
#
# 호출 방식
#   - Plan B(proot): SSH 강제명령(authorized_keys의 command=)으로만 실행됨.
#                    요청은 $SSH_ORIGINAL_COMMAND 에 "base64(인자1) base64(인자2) ..." 형태.
#   - Plan A(Termux 네이티브): `phone` 클라이언트가 같은 형식으로 직접 실행.
#
# 보안 원칙
#   1) 허용목록(allowlist)에 있는 동작만 실행. 임의 쉘 실행 없음(eval/sh -c 미사용).
#   2) 동작별 정책: allow | confirm | deny  (~/.hermes-bridge/policy.conf 로 조정)
#   3) confirm 동작은 '폰 화면'에 확인창(termux-dialog)을 띄움 → 사람이 직접 눌러야 실행.
#   4) 전역 직렬 잠금: 확인창이 떠 있는 동안 다른 동작(예: adb-tap)이 실행될 수 없음
#      → 에이전트가 스스로 확인창을 누르는 것을 방지.
#   5) 모든 요청/결과를 audit.log 에 기록.
set -uo pipefail
set -f            # 글롭 확장 금지
umask 077

BRIDGE_HOME="${HERMES_BRIDGE_HOME:-$HOME/.hermes-bridge}"
POLICY_FILE="$BRIDGE_HOME/policy.conf"
AUDIT_LOG="$BRIDGE_HOME/audit.log"
LOCK_DIR="$BRIDGE_HOME/.lock"
WORKSPACE="${HERMES_WORKSPACE:-$HOME/work}"
OUT_DIR="$WORKSPACE/.phone"
CONFIRM_TIMEOUT="${BRIDGE_CONFIRM_TIMEOUT:-60}"
ADB_KILL_AFTER="${BRIDGE_ADB_KILL_AFTER:-1}"   # 1이면 adb 동작 후 adb 서버 종료(다른 프로세스의 adb 재사용 차단)
MAX_ARG_LEN=4000

mkdir -p "$BRIDGE_HOME" "$OUT_DIR"

die()   { printf '{"ok":false,"error":%s}\n' "$(json_str "$1")"; audit "DENY/ERR" "$1"; exit "${2:-1}"; }
json_str() { jq -Rn --arg s "$1" '$s'; }
audit() { printf '%s\t%s\t%s\t%s\n' "$(date -Is)" "${SSH_CLIENT:-local}" "$1" "$2" >> "$AUDIT_LOG"; }

# ---------- 기본 정책 (policy.conf 가 덮어씀) ----------
declare -A POLICY=(
  [help]=allow [battery]=allow [notify]=allow [toast]=allow [vibrate]=allow
  [tts]=allow [torch]=allow [volume]=allow [brightness]=allow [wifi-info]=allow
  [clipboard-get]=confirm [clipboard-set]=allow [open-url]=confirm [share]=confirm
  [location]=confirm [camera-photo]=confirm [contacts]=confirm
  [sms-list]=confirm [sms-send]=confirm [call]=confirm
  [adb-status]=allow [adb-packages]=allow [adb-launch]=confirm
  [adb-screenshot]=confirm [adb-ui-dump]=confirm
  [adb-tap]=confirm [adb-swipe]=confirm [adb-text]=confirm [adb-key]=confirm
  [adb-setting-get]=allow [adb-shell]=deny
  # Hermes Hands (접근성 앱) — 세션 시작만 사람 확인, 세션 안의 동작은 앱이 범위·시간·보호막으로 통제
  [hands-status]=allow [hands-start]=confirm [hands-stop]=allow [hands-dump]=allow
  [hands-click]=allow [hands-type]=allow [hands-scroll]=allow [hands-back]=allow [hands-home]=allow
  [hands-launch]=allow [hands-tap]=allow [hands-swipe]=allow [hands-wait]=allow
  [hands-read]=allow [hands-run]=allow [hands-apps]=allow [hands-open]=allow
  # 설정 직접 변경 (화면 터치 없이, 무선 디버깅 ADB 셸 권한 — MacroDroid 도우미와 같은 방식)
  #   set-<이름> 으로 항목별 정책 지정. 연결이 끊길 수 있는 항목은 기본 confirm
  [settings]=allow [set]=allow
  [set-wifi]=confirm [set-airplane]=confirm [set-mobile-data]=confirm [set-location]=confirm [set-app-stop]=confirm
)
if [ -f "$POLICY_FILE" ]; then
  while IFS='=' read -r k v; do
    k="${k//[[:space:]]/}"; v="${v//[[:space:]]/}"
    [[ -z "$k" || "$k" == \#* ]] && continue
    [[ -n "${POLICY[$k]+x}" && "$v" =~ ^(allow|confirm|deny)$ ]] && POLICY[$k]="$v"
  done < "$POLICY_FILE"
fi

# ---------- 요청 파싱 ----------
RAW="${SSH_ORIGINAL_COMMAND:-${PHONE_BRIDGE_REQUEST:-}}"
[ -z "$RAW" ] && die "empty request"
ARGS=()
for tok in $RAW; do                      # 토큰은 base64라 공백/메타문자 없음
  [[ "$tok" =~ ^[A-Za-z0-9+/=]+$ ]] || die "malformed token"
  dec="$(printf '%s' "$tok" | base64 -d 2>/dev/null)" || die "bad base64"
  [ "${#dec}" -le "$MAX_ARG_LEN" ] || die "argument too long"
  ARGS+=("$dec")
done
ACTION="${ARGS[0]}"; ARGS=("${ARGS[@]:1}")
[[ -n "${POLICY[$ACTION]+x}" ]] || die "unknown action: $ACTION (phone help 참고)"
MODE="${POLICY[$ACTION]}"
# set 은 항목별 정책이 있으면 그것을 따름 (예: set-wifi=confirm)
if [ "$ACTION" = set ] && [ -n "${ARGS[0]:-}" ] && [ -n "${POLICY[set-${ARGS[0]}]+x}" ]; then MODE="${POLICY[set-${ARGS[0]}]}"; fi
[ "$MODE" = deny ] && die "action '$ACTION' is denied by policy"

arg()  { printf '%s' "${ARGS[$1]:-}"; }
need() { [ "${#ARGS[@]}" -ge "$1" ] || die "usage: $ACTION $2"; }
int()  { [[ "$1" =~ ^-?[0-9]+$ ]] || die "integer expected: $1"; }

# ---------- 전역 직렬 잠금 ----------
got_lock=0
for _ in $(seq 1 $((CONFIRM_TIMEOUT + 30))); do
  if mkdir "$LOCK_DIR" 2>/dev/null; then got_lock=1; break; fi
  # 죽은 프로세스가 남긴 잠금 정리
  holder="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
  if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then rm -rf "$LOCK_DIR"; continue; fi
  sleep 1
done
[ "$got_lock" = 1 ] || die "bridge busy"
echo $$ > "$LOCK_DIR/pid"
trap 'rm -rf "$LOCK_DIR"' EXIT

HANDS_PORT="${HANDS_PORT:-47800}"
hands() {  # hands <cmd> [jq 인자들로 만든 추가 필드 JSON]
  local extra="${2:-}" tok line
  [ -n "$extra" ] || extra='{}'
  [ -f "$BRIDGE_HOME/hands.token" ] || die "Hermes Hands 미연결: 앱에서 토큰 복사 후 Termux에서 'phone-hands-pair <토큰>'"
  tok="$(head -c 200 "$BRIDGE_HOME/hands.token")"
  local k; for k in 1 2 3 4 5; do       # 서비스가 다시 붙는 중이면 잠깐 기다렸다 재시도
    { exec 3<>"/dev/tcp/127.0.0.1/$HANDS_PORT"; } 2>/dev/null && break
    [ $k = 5 ] && die "Hermes Hands 앱 응답 없음 (접근성 서비스 켜짐 확인)"; sleep 1
  done
  jq -cn --arg t "$tok" --arg c "$1" --argjson x "$extra" '$x + {token:$t, cmd:$c}' >&3
  IFS= read -r -t "${HANDS_READ_TIMEOUT:-90}" line <&3 || line='{"ok":false,"error":"timeout"}'
  exec 3>&- 3<&-
  printf '%s\n' "$line"
}

# Hermes Hands: 금지 앱이면 확인창을 띄우기 전에 바로 거부
if [ "$ACTION" = hands-start ] && [ -n "${ARGS[1]:-}" ]; then
  chk="$(hands check "$(jq -cn --arg a "${ARGS[1]}" '{apps:($a|split(","))}')")"
  [ "$(jq -r '.ok' <<<"$chk" 2>/dev/null)" = true ] || { audit "REFUSED" "$ACTION ${ARGS[1]}"; printf '%s\n' "$chk"; exit 1; }
fi

# ---------- 사람 확인 ----------
confirm() {
  local summary="$1" res
  res="$(timeout "$CONFIRM_TIMEOUT" termux-dialog confirm -t "Hermes 요청 승인" -i "$summary" 2>/dev/null)" || true
  if [ "$(printf '%s' "$res" | jq -r '.text // empty' 2>/dev/null)" != "yes" ]; then
    audit "REJECTED" "$summary"
    die "user did not approve on phone screen"
  fi
  audit "APPROVED" "$summary"
}
SUMMARY="$ACTION"; for a in "${ARGS[@]}"; do SUMMARY+=" «${a//$'\n'/⏎}»"; done
[ "$MODE" = confirm ] && confirm "$SUMMARY"
audit "RUN" "$SUMMARY"

# ---------- ADB 헬퍼 (무선 디버깅으로 자기 자신에 연결) ----------
SHELL_MODE=adb
rish_ok() {   # Shizuku(rish): 와이파이 한 번 시작 후엔 5G 에서도 셸 권한 사용 (네트워크 포트 없음)
  command -v rish >/dev/null 2>&1 || return 1
  [ "$(timeout 8 rish -c 'id -u' 2>/dev/null | tr -dc '0-9')" = 2000 ]
}
adb_ready() {
  if rish_ok; then SHELL_MODE=rish; return 0; fi
  command -v adb >/dev/null || die "android-tools 미설치 (pkg install android-tools)"
  if ! adb devices 2>/dev/null | awk 'NR>1 && $2=="device"{f=1} END{exit !f}'; then
    # 무선 디버깅 포트는 켤 때마다 바뀜 → ① 시스템 속성에서 지금 포트 ② mDNS ③ 저장된 엔드포인트 순서로 시도
    local port eps=() ep out=""
    port="$(getprop service.adb.tls.port 2>/dev/null | tr -dc '0-9')"
    [ -n "$port" ] && [ "$port" != 0 ] && eps+=("127.0.0.1:$port")
    ep="$(adb mdns services 2>/dev/null | awk '/_adb-tls-connect/{print $NF; exit}')"; [ -n "$ep" ] && eps+=("$ep")
    [ -f "$BRIDGE_HOME/adb-endpoint" ] && eps+=("$(head -1 "$BRIDGE_HOME/adb-endpoint")")
    for ep in "${eps[@]}"; do
      [[ "$ep" =~ ^[A-Za-z0-9.:-]+$ ]] || continue
      out="$(adb connect "$ep" 2>&1)"
      adb devices 2>/dev/null | awk 'NR>1 && $2=="device"{f=1} END{exit !f}' && break
    done
    if ! adb devices 2>/dev/null | awk 'NR>1 && $2=="device"{f=1} END{exit !f}'; then
      if [ -z "$port" ] || [ "$port" = 0 ]; then
        die "ADB 미연결: 무선 디버깅이 꺼져 있어요 (와이파이 필요) → 와이파이에서 무선 디버깅 켜기, 또는 Shizuku 를 한 번 시작해 두면 5G 에서도 됩니다 (bash ~/hermes-fold7/scripts/45-shizuku.sh)"
      else
        die "ADB 미연결: 무선 디버깅은 켜져 있지만 이 폰과 페어링이 안 됐어요 → Termux 에서 bash ~/hermes-fold7/scripts/40-adb-pair.sh (한 번만) [${out:0:80}]"
      fi
    fi
  fi
  # 같은 폰이 mDNS 이름과 IP:포트로 두 번 잡히면 "more than one device" → 첫 기기로 고정
  ANDROID_SERIAL="$(adb devices 2>/dev/null | awk 'NR>1 && $2=="device"{print $1; exit}')"
  export ANDROID_SERIAL
}
adb_done() { [ "$SHELL_MODE" = adb ] && [ "$ADB_KILL_AFTER" = 1 ] && adb kill-server >/dev/null 2>&1; true; }
# 셸 권한 명령: Shizuku(rish) 가 있으면 그쪽, 없으면 adb. (값은 호출 전에 검증됨, %q 로 한 번 더 인용)
A() { if [ "$SHELL_MODE" = rish ]; then rish -c "$(printf '%q ' "$@")"; else adb shell -- "$@"; fi; }
AX() { if [ "$SHELL_MODE" = rish ]; then rish -c "$(printf '%q ' "$@")"; else adb exec-out "$@"; fi; }   # 바이너리 출력
safe_word() { [[ "$1" =~ ^[A-Za-z0-9._:/-]+$ ]] || die "unsafe value: $1"; }

# ---------- 설정 직접 변경 ----------
onoff() { case "$1" in on|1|true|yes|켜기) echo on ;; off|0|false|no|끄기) echo off ;; *) die "on 또는 off: $1" ;; esac; }
rng()   { int "$1"; [ "$1" -ge "$2" ] && [ "$1" -le "$3" ] || die "범위 $2~$3: $1"; }
sget()  { A settings get "$1" "$2" 2>/dev/null | tr -d '\r'; }
settings_json() {
  jq -n --arg dark "$(A cmd uimode night 2>/dev/null | tr -d '\r' | awk '{print $NF}')" \
    --arg bright "$(sget system screen_brightness)" --arg auto "$(sget system screen_brightness_mode)" \
    --arg timeout "$(sget system screen_off_timeout)" --arg rotate "$(sget system accelerometer_rotation)" \
    --arg zen "$(sget global zen_mode)" --arg wifi "$(sget global wifi_on)" --arg bt "$(sget global bluetooth_on)" \
    --arg air "$(sget global airplane_mode_on)" --arg data "$(sget global mobile_data)" \
    --arg saver "$(sget global low_power)" --arg font "$(sget system font_scale)" \
    --arg anim "$(sget global window_animation_scale)" --arg awake "$(sget global stay_on_while_plugged_in)" \
    --arg loc "$(sget secure location_mode)" \
    '{ok:true, dark:$dark, brightness:$bright, auto_brightness:$auto, screen_timeout_ms:$timeout, auto_rotate:$rotate,
      dnd_zen_mode:$zen, wifi:$wifi, bluetooth:$bt, airplane:$air, mobile_data:$data, battery_saver:$saver,
      font_scale:$font, animation_scale:$anim, stay_awake:$awake, location_mode:$loc}'
}
do_set() {  # do_set 이름 값 [값2] → 바꾼 뒤 실제 값을 다시 읽어서 돌려줌
  local n="$1" v="${2:-}" now="" on
  case "$n" in
    dark)            on="$(onoff "$v")"; A cmd uimode night "$([ "$on" = on ] && echo yes || echo no)" >/dev/null
                     now="$(A cmd uimode night | tr -d '\r')" ;;
    brightness)      rng "$v" 0 255; A settings put system screen_brightness_mode 0; A settings put system screen_brightness "$v"; now="$(sget system screen_brightness)" ;;
    auto-brightness) on="$(onoff "$v")"; A settings put system screen_brightness_mode "$([ "$on" = on ] && echo 1 || echo 0)"; now="$(sget system screen_brightness_mode)" ;;
    timeout)         rng "$v" 15 1800; A settings put system screen_off_timeout "$((v*1000))"; now="$(sget system screen_off_timeout)" ;;
    rotate)          on="$(onoff "$v")"; A settings put system accelerometer_rotation "$([ "$on" = on ] && echo 1 || echo 0)"; now="$(sget system accelerometer_rotation)" ;;
    font)            [[ "$v" =~ ^[01](\.[0-9]{1,2})?$ ]] && awk -v x="$v" 'BEGIN{exit !(x>=0.8 && x<=1.5)}' || die "글자 크기 0.8~1.5: $v"
                     A settings put system font_scale "$v"; now="$(sget system font_scale)" ;;
    animations)      [[ "$v" =~ ^(0|0\.5|1|1\.5|2)$ ]] || die "애니메이션 0|0.5|1|1.5|2"
                     for k in window_animation_scale transition_animation_scale animator_duration_scale; do A settings put global "$k" "$v"; done
                     now="$(sget global animator_duration_scale)" ;;
    stay-awake)      on="$(onoff "$v")"; A settings put global stay_on_while_plugged_in "$([ "$on" = on ] && echo 7 || echo 0)"; now="$(sget global stay_on_while_plugged_in)" ;;
    dnd)             on="$(onoff "$v")"; A cmd notification set_dnd "$([ "$on" = on ] && echo priority || echo off)" >/dev/null; sleep 1; now="zen_mode=$(sget global zen_mode)" ;;
    battery-saver)   on="$(onoff "$v")"; A cmd power set-mode "$([ "$on" = on ] && echo 1 || echo 0)" >/dev/null; sleep 1; now="low_power=$(sget global low_power)" ;;
    wifi)            on="$(onoff "$v")"; A svc wifi "$([ "$on" = on ] && echo enable || echo disable)"; sleep 2; now="wifi_on=$(sget global wifi_on)" ;;
    bluetooth)       on="$(onoff "$v")"; A svc bluetooth "$([ "$on" = on ] && echo enable || echo disable)" >/dev/null 2>&1 \
                       || A cmd bluetooth_manager "$([ "$on" = on ] && echo enable || echo disable)" >/dev/null; sleep 2; now="bluetooth_on=$(sget global bluetooth_on)" ;;
    mobile-data)     on="$(onoff "$v")"; A svc data "$([ "$on" = on ] && echo enable || echo disable)"; sleep 1; now="mobile_data=$(sget global mobile_data)" ;;
    airplane)        on="$(onoff "$v")"; A cmd connectivity airplane-mode "$([ "$on" = on ] && echo enable || echo disable)"; sleep 1; now="airplane=$(sget global airplane_mode_on)" ;;
    location)        on="$(onoff "$v")"; A cmd location set-location-enabled "$([ "$on" = on ] && echo true || echo false)"; now="location_mode=$(sget secure location_mode)" ;;
    nfc)             on="$(onoff "$v")"; A svc nfc "$([ "$on" = on ] && echo enable || echo disable)"; now="(nfc ${on})" ;;
    volume)          local st; case "$v" in media) st=3 ;; ring) st=2 ;; alarm) st=4 ;; notification) st=5 ;; call) st=0 ;; *) die "volume media|ring|alarm|notification|call 0~15" ;; esac
                     rng "${3:-}" 0 15; A cmd media_session volume --stream "$st" --set "$3" >/dev/null 2>&1 || A media volume --stream "$st" --set "$3" >/dev/null 2>&1
                     now="$(A cmd media_session volume --stream "$st" --get 2>/dev/null | tr -d '\r' | grep -oE 'volume is [0-9]+' | head -1)" ;;
    app-stop)        pkg_ok "$v"; case "$v" in com.termux*|ai.hermesfold7.hands|android|com.android.systemui) die "이 앱은 멈출 수 없음: $v" ;; esac
                     A am force-stop "$v"; now="stopped" ;;
    *) die "모르는 설정: $n (가능: dark brightness auto-brightness timeout rotate font animations stay-awake dnd battery-saver wifi bluetooth mobile-data airplane location nfc volume app-stop)" ;;
  esac
  jq -cn --arg n "$n" --arg v "$v${3:+ $3}" --arg now "$now" '{ok:true, setting:$n, value:$v, now:$now}'
}

# ---------- Hermes Hands 헬퍼 (127.0.0.1:47800, 토큰 인증 한 줄 JSON) ----------
pkg_ok() { [[ "$1" =~ ^[A-Za-z0-9_.]+$ ]] || die "bad package: $1"; }
node_sel() {  # 숫자면 i, text:… / id:… 형태 지원
  case "$1" in
    text:*) jq -cn --arg v "${1#text:}" '{text:$v}' ;;
    id:*)   jq -cn --arg v "${1#id:}" '{id:$v}' ;;
    *)      int "$1"; jq -cn --argjson v "$1" '{i:$v}' ;;
  esac
}

ts="$(date +%Y%m%d-%H%M%S)"
case "$ACTION" in
  help)          printf '%s\n' "${!POLICY[@]}" | sort | while read -r k; do echo "$k=${POLICY[$k]}"; done ;;
  battery)       termux-battery-status ;;
  notify)        need 2 "TITLE TEXT [http://127.0.0.1:포트 — 누르면 열기]"
                 if [ -n "${ARGS[2]:-}" ]; then [[ "${ARGS[2]}" =~ ^http://127\.0\.0\.1:[0-9]{2,5}/?$ ]] || die "알림 링크는 http://127.0.0.1:포트 만"
                   termux-notification --id hermes-reply --title "$(arg 0)" --content "$(arg 1)" --action "termux-open-url ${ARGS[2]}" && echo '{"ok":true}'
                 else termux-notification --title "$(arg 0)" --content "$(arg 1)" && echo '{"ok":true}'; fi ;;
  toast)         need 1 "TEXT"; termux-toast "$(arg 0)" && echo '{"ok":true}' ;;
  vibrate)       termux-vibrate -d 400 && echo '{"ok":true}' ;;
  tts)           need 1 "TEXT"; termux-tts-speak "$(arg 0)" && echo '{"ok":true}' ;;
  torch)         need 1 "on|off"; [[ "$(arg 0)" =~ ^(on|off)$ ]] || die "on|off"; termux-torch "$(arg 0)" && echo '{"ok":true}' ;;
  volume)        if [ "${#ARGS[@]}" -eq 0 ]; then termux-volume; else need 2 "STREAM LEVEL"; safe_word "$(arg 0)"; int "$(arg 1)"; termux-volume "$(arg 0)" "$(arg 1)"; fi ;;
  brightness)    need 1 "0-255|auto"; [[ "$(arg 0)" =~ ^([0-9]{1,3}|auto)$ ]] || die "0-255|auto"; termux-brightness "$(arg 0)" && echo '{"ok":true}' ;;
  wifi-info)     termux-wifi-connectioninfo ;;
  clipboard-get) termux-clipboard-get ;;
  clipboard-set) need 1 "TEXT"; printf '%s' "$(arg 0)" | termux-clipboard-set && echo '{"ok":true}' ;;
  open-url)      need 1 "URL"; [[ "$(arg 0)" =~ ^https?:// ]] || die "http(s) URL only"; termux-open-url "$(arg 0)" && echo '{"ok":true}' ;;
  share)         need 1 "FILE(작업폴더 내부)"; f="$(realpath -m "$WORKSPACE/$(arg 0)")"; [[ "$f" == "$WORKSPACE"/* && -f "$f" ]] || die "file must be inside workspace"; termux-share "$f" && echo '{"ok":true}' ;;
  location)      termux-location -p network -r once ;;
  camera-photo)  f="$OUT_DIR/photo-$ts.jpg"; cam="${ARGS[0]:-0}"; int "$cam"; termux-camera-photo -c "$cam" "$f" && jq -n --arg p "${f#"$WORKSPACE"/}" '{ok:true,path:$p}' ;;
  contacts)      termux-contact-list ;;
  sms-list)      n="${ARGS[0]:-20}"; int "$n"; termux-sms-list -l "$n" ;;
  sms-send)      need 2 "NUMBER TEXT"; [[ "$(arg 0)" =~ ^\+?[0-9-]{3,20}$ ]] || die "bad number"; termux-sms-send -n "$(arg 0)" "$(arg 1)" && echo '{"ok":true}' ;;
  call)          need 1 "NUMBER"; [[ "$(arg 0)" =~ ^\+?[0-9-]{3,20}$ ]] || die "bad number"; termux-telephony-call "$(arg 0)" && echo '{"ok":true}' ;;

  adb-status)    adb_ready; if [ "$SHELL_MODE" = rish ]; then jq -cn '{ok:true, via:"shizuku", note:"5G 에서도 동작 (재부팅 전까지)"}'; else adb devices -l; fi; adb_done ;;
  adb-packages)  adb_ready; A pm list packages -3; adb_done ;;
  adb-launch)    need 1 "PACKAGE"; safe_word "$(arg 0)"; adb_ready; A monkey -p "$(arg 0)" -c android.intent.category.LAUNCHER 1 >/dev/null && echo '{"ok":true}'; adb_done ;;
  adb-screenshot) adb_ready; f="$OUT_DIR/screen-$ts.png"; AX screencap -p > "$f" && jq -n --arg p "${f#"$WORKSPACE"/}" '{ok:true,path:$p}'; adb_done ;;
  adb-ui-dump)   adb_ready; f="$OUT_DIR/ui-$ts.xml"; A uiautomator dump /sdcard/.hermes-ui.xml >/dev/null && AX cat /sdcard/.hermes-ui.xml > "$f" && A rm -f /sdcard/.hermes-ui.xml && jq -n --arg p "${f#"$WORKSPACE"/}" '{ok:true,path:$p}'; adb_done ;;
  adb-tap)       need 2 "X Y"; int "$(arg 0)"; int "$(arg 1)"; adb_ready; A input tap "$(arg 0)" "$(arg 1)" && echo '{"ok":true}'; adb_done ;;
  adb-swipe)     need 4 "X1 Y1 X2 Y2 [MS]"; for i in 0 1 2 3; do int "$(arg $i)"; done; ms="${ARGS[4]:-300}"; int "$ms"; adb_ready; A input swipe "$(arg 0)" "$(arg 1)" "$(arg 2)" "$(arg 3)" "$ms" && echo '{"ok":true}'; adb_done ;;
  adb-text)      need 1 "TEXT(영문/숫자/기본기호)"; [[ "$(arg 0)" =~ ^[A-Za-z0-9\ ._@:/-]+$ ]] || die "adb-text: 한글/특수문자는 clipboard-set 후 붙여넣기 사용"; adb_ready; t="$(arg 0)"; A input text "${t// /%s}" && echo '{"ok":true}'; adb_done ;;
  adb-key)       need 1 "KEYCODE(예: KEYCODE_HOME)"; [[ "$(arg 0)" =~ ^(KEYCODE_[A-Z0-9_]+|[0-9]{1,3})$ ]] || die "bad keycode"; adb_ready; A input keyevent "$(arg 0)" && echo '{"ok":true}'; adb_done ;;
  adb-setting-get) need 2 "system|secure|global KEY"; [[ "$(arg 0)" =~ ^(system|secure|global)$ ]] || die "namespace"; safe_word "$(arg 1)"; adb_ready; A settings get "$(arg 0)" "$(arg 1)"; adb_done ;;
  adb-shell)     need 1 "COMMAND..."; adb_ready; A "${ARGS[@]}"; rc=$?; adb_done; exit $rc ;;

  settings)      adb_ready; settings_json; adb_done ;;
  set)           need 2 "이름 값  (phone set dark on / brightness 120 / volume media 7 …)"
                 # 밝기·볼륨은 무선 디버깅 없이도 Termux:API 로 가능 → ADB 가 안 되면 그쪽으로
                 if ! ( adb_ready ) >/dev/null 2>&1; then
                   case "$(arg 0)" in
                     brightness) rng "$(arg 1)" 0 255; termux-brightness "$(arg 1)" >/dev/null && jq -cn --arg v "$(arg 1)" '{ok:true, setting:"brightness", value:$v, via:"termux-api"}'; exit ;;
                     volume) case "$(arg 1)" in media) st=music ;; ring|alarm|notification|call) st="$(arg 1)" ;; *) die "volume media|ring|alarm|notification|call 0~15" ;; esac
                             rng "${ARGS[2]:-}" 0 15; termux-volume "$st" "${ARGS[2]}" >/dev/null && jq -cn --arg v "$(arg 1) ${ARGS[2]}" '{ok:true, setting:"volume", value:$v, via:"termux-api"}'; exit ;;
                   esac
                 fi
                 adb_ready; do_set "$(arg 0)" "$(arg 1)" "${ARGS[2]:-}"; adb_done ;;

  hands-status)  hands status ;;
  hands-start)   need 3 "MINUTES PKG[,PKG..] TITLE"; int "$(arg 0)"
                 IFS=',' read -r -a PK <<< "$(arg 1)"; for p in "${PK[@]}"; do pkg_ok "$p"; done
                 hands start "$(jq -cn --argjson m "$(arg 0)" --arg a "$(arg 1)" --arg t "$(arg 2)" '{minutes:$m, apps:($a|split(",")), title:$t}')" ;;
  hands-stop)    hands stop ;;
  hands-apps)    # 설치된 앱 찾기: phone hands-apps 카카오  → [{name, package}]
                 hands apps "$(jq -cn --arg q "${ARGS[0]:-}" '{q:$q}')" ;;
  hands-open)    need 1 "PACKAGE (phone hands-apps 로 찾기)"; pkg_ok "$(arg 0)"; hands open "$(jq -cn --arg p "$(arg 0)" '{package:$p}')" ;;
  hands-read)    # 화면 구조를 '코드처럼' 짧은 들여쓰기 텍스트로: [번호] 종류 "글자" #id {click,edit,…}
                 out="$(hands dump)"
                 if [ "$(jq -r '.ok' <<<"$out" 2>/dev/null)" != true ]; then printf '%s\n' "$out"; exit 1; fi
                 jq -r '"app: \(.package)  nodes: \(.count)",
                   ((.nodes | map(.d) | min) as $m | .nodes[] |
                    "\("  " * ([.d - $m, 12] | min))[\(.i)] \(.cls)" +
                    (if .pw then " «password»" elif .text then " \"\(.text)\"" else "" end) +
                    (if .desc and .desc != .text then " (\(.desc))" else "" end) +
                    (if .id then " #\(.id | sub(".*:id/"; ""))" else "" end) +
                    ([ (if .click then "click" else empty end), (if .edit then "edit" else empty end),
                       (if .scroll then "scroll" else empty end), (if .checked != null then "checked=\(.checked)" else empty end) ]
                     | if length > 0 then " {" + join(",") + "}" else "" end))' <<<"$out" ;;
  hands-run)     # 여러 단계를 한 번에 실행: JSON 직접 / @레시피이름 (~/work/recipes/이름.json) / 작업폴더 안 .json 파일
                 need 1 "'[{\"do\":\"click\",\"match\":\"^Display\"}, …]' | @레시피 | 파일.json"
                 src="$(arg 0)"
                 if [[ "$src" == @* ]]; then
                   [[ "${src#@}" =~ ^[A-Za-z0-9_-]{1,60}$ ]] || die "레시피 이름은 영문·숫자·-_ 만"
                   f="$WORKSPACE/recipes/${src#@}.json"; [ -f "$f" ] || die "레시피 없음: $f"; prog="$(head -c 65536 "$f")"
                 elif [[ "$src" == *.json ]]; then
                   f="$(realpath -m -- "$src" 2>/dev/null)"; [[ "$f" == "$(realpath -m "$WORKSPACE")"/* ]] || die "작업 폴더($WORKSPACE) 안의 파일만"
                   [ -f "$f" ] || die "파일 없음: $src"; prog="$(head -c 65536 "$f")"
                 else prog="$src"; fi
                 body="$(jq -c 'if type == "array" then {steps: .} elif type == "object" and (.steps | type) == "array" then {steps: .steps} else error("형식: 단계 배열 또는 {steps:[…]}") end' <<<"$prog" 2>&1)" \
                   || die "레시피 JSON 오류: $body"
                 HANDS_READ_TIMEOUT=900 hands run "$body" ;;
  hands-dump)    hands dump ;;
  hands-click)   need 1 "INDEX | text:글자 | id:뷰ID"; hands click "$(node_sel "$(arg 0)")" ;;
  hands-type)    need 2 "INDEX TEXT [enter]"; int "$(arg 0)"; ent=false; [ "${ARGS[2]:-}" = enter ] && ent=true
                 hands type "$(jq -cn --argjson i "$(arg 0)" --arg v "$(arg 1)" --argjson e "$ent" '{i:$i, value:$v, enter:$e}')" ;;
  hands-scroll)  dir="${ARGS[0]:-down}"; [[ "$dir" =~ ^(up|down)$ ]] || die "up|down"
                 if [ -n "${ARGS[1]:-}" ]; then int "$(arg 1)"; hands scroll "$(jq -cn --arg d "$dir" --argjson i "$(arg 1)" '{dir:$d, i:$i}')"
                 else hands scroll "$(jq -cn --arg d "$dir" '{dir:$d}')"; fi ;;
  hands-back)    hands back ;;
  hands-home)    hands home ;;
  hands-launch)  need 1 "PACKAGE"; pkg_ok "$(arg 0)"; hands launch "$(jq -cn --arg p "$(arg 0)" '{package:$p}')" ;;
  hands-tap)     need 2 "X Y"; int "$(arg 0)"; int "$(arg 1)"; hands tap "$(jq -cn --argjson x "$(arg 0)" --argjson y "$(arg 1)" '{x:$x, y:$y}')" ;;
  hands-swipe)   need 4 "X1 Y1 X2 Y2 [MS]"; for i in 0 1 2 3; do int "$(arg $i)"; done; ms="${ARGS[4]:-400}"; int "$ms"
                 hands swipe "$(jq -cn --argjson a "$(arg 0)" --argjson b "$(arg 1)" --argjson c "$(arg 2)" --argjson d "$(arg 3)" --argjson m "$ms" '{x1:$a,y1:$b,x2:$c,y2:$d,ms:$m}')" ;;
  hands-wait)    ms="${ARGS[0]:-1000}"; int "$ms"; hands wait "$(jq -cn --argjson m "$ms" '{ms:$m}')" ;;
  *)             die "not implemented: $ACTION" ;;
esac
